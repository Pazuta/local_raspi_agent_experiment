[Unit]
Description=Local chatbot web service
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=<SERVICE_USER>
WorkingDirectory=<APP_DIRECTORY>
EnvironmentFile=<APP_DIRECTORY>/.env
ExecStart=<APP_DIRECTORY>/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
